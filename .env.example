# Copy to .env and fill in real values. Never commit .env.

# Twilio (required for live voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

DEBUG=true
IVR_SILENCE_TIMEOUT_S=5.0
# Keep false for smooth phone audio (Twilio buffers). true often sounds choppy.
IVR_PLAYBACK_REALTIME=false
IVR_VAD_RMS_THRESHOLD=250.0
IVR_MIN_LID_CONFIDENCE=0.15

# --- Phase 10: real SpeechBrain LID (default) ---
IVR_USE_SPEECHBRAIN_LID=true
IVR_LID_FORCE_LANGUAGE=
IVR_SPEECHBRAIN_MODEL=speechbrain/lang-id-voxlingua107-ecapa
# pip install -r requirements-ivr-lid.txt  (Python 3.10–3.12 recommended)

# --- Phase 9 smoke profile (fixed LID) — uncomment to force ---
# IVR_USE_SPEECHBRAIN_LID=false
# IVR_LID_FORCE_LANGUAGE=en

# Optional local Piper (multilingual). Leave unset to use Windows SAPI.
# IVR_PIPER_MODEL_PATH=
# IVR_PIPER_BIN=
